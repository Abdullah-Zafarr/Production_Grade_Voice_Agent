# --- LiveKit Configuration ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_WEBHOOK_KEY=your-webhook-key

# --- OpenAI Configuration ---
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-4o-mini

# --- Transcription (Gladia) ---
GLADIA_API_KEY=your-gladia-key

# --- Voice Synthesis (Cartesia) ---
CARTESIA_API_KEY=your-cartesia-key
CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# --- Calendar (Cal.com) ---
CALCOM_API_KEY=cal_live_your-key
CALCOM_EVENT_TYPE_ID=your-id

# --- Database & Storage (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# --- Call Recording Storage (S3 / Supabase) ---
S3_ACCESS_KEY_ID=your-key
S3_SECRET_ACCESS_KEY=your-secret
S3_REGION=ap-southeast-2
S3_BUCKET=recordings
S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3

# --- Clinic Identity & Settings ---
CLINIC_NAME=Soul Imaging Radiology Clinic
AGENT_NAME=Sarah
TIMEZONE=Australia/Sydney
API_ALLOWED_ORIGINS=*

# --- Admin Fallback Credentials ---
# Use a bcrypt hash for the password. You can generate one using a tool or a script.
ADMIN_FALLBACK_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$your-bcrypt-hash

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=https://your-app.fly.dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
